{
  "name": "sao-mai-borrowed-items",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-16",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saomai-borrowed-items-db",
      "database_id": "b96c78c8-e63f-48df-b8c9-26edd7fd11ad"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "saomai-borrowed-items-images"
    }
  ]
}
